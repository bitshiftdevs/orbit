{
	"name": "project-manager",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "run-p type-check \"build-only {@}\" --",
		"preview": "pnpm run build && wrangler dev",
		"build-only": "vite build",
		"type-check": "vue-tsc --build",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"env": "dotenv -e .dev.vars",
		"gen:prisma": "npx prisma generate",
		"create:mig": "npx wrangler d1 migrations create project-manager-db",
		"gen:mig": "npx prisma migrate diff --from-empty --to-schema-datamodel ./prisma/schema.prisma --script --output",
		"apply:mig:local": "npx wrangler d1 migrations apply project-manager-db --local",
		"apply:mig:deploy": "npx wrangler d1 migrations apply project-manager-db --remote",
		"seed:local": "npx wrangler d1 execute project-manager-db --local --file=./prisma/seed.sql",
		"seed:deploy": "npx wrangler d1 execute project-manager-db --remote --file=./prisma/seed.sql",
		"reset:local": "npx wrangler d1 execute project-manager-db --local --command=RESET",
		"reset:deploy": "npx wrangler d1 execute project-manager-db --remote --command=RESET",
		"reset:local:migrate": "npx wrangler d1 migrations reset project-manager-db --local",
		"reset:deploy:migrate": "npx wrangler d1 migrations reset project-manager-db --remote"
	},
	"dependencies": {
		"@prisma/adapter-d1": "^6.12.0",
		"@prisma/client": "^6.12.0",
		"@tailwindcss/vite": "^4.1.11",
		"@vee-validate/zod": "^4.15.1",
		"@vueuse/core": "^13.5.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"hono": "^4.8.5",
		"lucide-vue-next": "^0.525.0",
		"pinia": "^3.0.3",
		"reka-ui": "^2.3.2",
		"tailwind-merge": "^3.3.1",
		"tailwindcss": "^4.1.11",
		"tw-animate-css": "^1.3.5",
		"vee-validate": "^4.15.1",
		"vue": "^3.5.17",
		"vue-router": "^4.5.1",
		"zod": "^4.0.5"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.9.6",
		"@tsconfig/node22": "^22.0.2",
		"@types/node": "^22.15.32",
		"@vitejs/plugin-vue": "^6.0.0",
		"@vue/tsconfig": "^0.7.0",
		"npm-run-all2": "^8.0.4",
		"prisma": "^6.12.0",
		"typescript": "~5.8.0",
		"vite": "^7.0.0",
		"vite-plugin-vue-devtools": "^7.7.7",
		"vue-tsc": "^2.2.10",
		"wrangler": "^4.25.0"
	},
	"packageManager": "pnpm@9.15.4+sha512.b2dc20e2fc72b3e18848459b37359a32064663e5627a51e4c74b2c29dd8e8e0491483c3abb40789cfd578bf362fb6ba8261b05f0387d76792ed6e23ea3b1b6a0"
}