# Postgres connection string (docker compose db, Neon, Supabase, self-hosted, etc.)
# The default below matches the local db from `docker compose up -d`.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/postgres"

# 32-byte key (base64-encoded) used to encrypt secrets & env vars at rest.
# Generate: openssl rand -base64 32
SECRETS_MASTER_KEY=""

# Random string used to sign session cookies.
# Generate: openssl rand -base64 48
SESSION_SECRET=""

# Public URL of the deployed app (used for invite links).
APP_URL="http://orbit.local:8888"

# VAPID keys for Web Push notifications.
# Generate: bun run vapid:keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact URL/email exposed to push services (required by spec).
VAPID_SUBJECT="mailto:admin@example.com"
