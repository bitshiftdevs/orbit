{
	"installCommand": "bun install",
	"devCommand": "bun run dev:vite",
	"buildCommand": "bun run db:migrate && bun run build",
	"outputDirectory": "dist",
	"rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
	"functions": {
		"api/[[...slug]].ts": {
			"includeFiles": "node_modules/@node-rs/**"
		}
	}
}
