# Postgres connection string (Prisma Postgres, Neon, Supabase, self-hosted, etc.)
DATABASE_URL="postgres://user:password@host:5432/bitshift_orbit"

# 32-byte key (base64-encoded) used to encrypt secrets & env vars at rest.
# Generate: openssl rand -base64 32
SECRETS_MASTER_KEY=""

# Random string used to sign session cookies.
# Generate: openssl rand -base64 48
SESSION_SECRET=""

# Public URL of the deployed app (used for invite links).
APP_URL="http://localhost:8888"
