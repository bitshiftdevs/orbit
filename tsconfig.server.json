{
	"extends": "@tsconfig/node22/tsconfig.json",
	"include": ["server/**/*.ts", "netlify/**/*.ts"],
	"compilerOptions": {
		"noEmit": true,
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["node"],
		"baseUrl": ".",
		"paths": {
			"@server/*": ["./server/*"]
		}
	}
}
